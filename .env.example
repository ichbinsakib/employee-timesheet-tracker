# Copy this file to .env and adjust. .env is never committed to GitHub.

# ---- Where your data lives (on this desktop) ----
# Root folder for data/, backups/, reports/, imports/, logs/, secrets/.
# Default (empty) = the application folder. Recommended: a separate folder, e.g.
# TIMESHEET_HOME=D:\EmployeeTimesheet
TIMESHEET_HOME=

# Optional: override individual folders
# TIMESHEET_DATA_DIR=D:\EmployeeTimesheet\data
# TIMESHEET_BACKUP_DIR=E:\TimesheetBackups
# TIMESHEET_REPORTS_DIR=
# TIMESHEET_IMPORTS_DIR=
# TIMESHEET_LOGS_DIR=
# TIMESHEET_SECRETS_DIR=

# Optional: use PostgreSQL instead of SQLite later
# DATABASE_URL=postgresql+psycopg://user:password@localhost/timesheets

# ---- Web server ----
# 0.0.0.0 = reachable from other PCs on your LAN (http://DESKTOP-IP:8000)
# 127.0.0.1 = this PC only (remote access still works through Tailscale Serve)
TIMESHEET_HOST=0.0.0.0
TIMESHEET_PORT=8000

# ---- Sign-in sessions ----
SESSION_HOURS=12
# auto = Secure cookie when the request came over HTTPS (Tailscale Serve). true/false to force.
COOKIE_SECURE=auto

# ---- Gmail (defaults; can be changed later in Settings) ----
# GMAIL_CREDENTIALS_FILE=   (default: <secrets>\gmail_credentials.json)
# GMAIL_TOKEN_FILE=         (default: <secrets>\gmail_token.json)
GMAIL_QUERY=has:attachment (filename:xlsx OR filename:xlsm)
GMAIL_LOOKBACK_DAYS=14
GMAIL_SYNC_INTERVAL_MINUTES=15

# ---- Backups & reports (defaults; can be changed later in Settings) ----
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=30
DAILY_REPORT_TIME=19:00

# Set to false only for debugging (disables Gmail sync, backups and reports)
ENABLE_SCHEDULER=true
